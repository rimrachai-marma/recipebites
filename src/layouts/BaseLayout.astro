---
interface Props {
  title?: string;
}

const { title = "Recipe Bites" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Nunito+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/" class="brand">
        <img src="/logo.svg" alt="Recipe Bites" height="44" />
      </a>

      <nav>
        <ul>
          <li><a href="/" class:list={[{ active: currentPath === "/" }]}>Home</a></li>
          <li><a href="/about" class:list={[{ active: currentPath === "/about" }]}>About</a></li>
          <li><a href="/recipes" class:list={[{ active: currentPath.startsWith("/recipes") }]}>Recipes</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
  }
  header {
    background-color: #fff8f0;
    border-bottom: 3px solid #e8622c;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;

    .brand img {
      display: block;
      height: 44px;
      width: auto;
    }

    h1 {
      margin: 0;
      font-family: "Fraunces", serif;
      font-weight: 700;
      color: #b8441f;
      font-size: 1.5em;
    }
    ul {
      display: flex;
      list-style-type: none;
      gap: 20px;
      padding: 0;
    }
    nav a {
      text-decoration: none;
      color: #6b4423;
      font-weight: 600;
      border-bottom: 2px solid transparent;
      transition:
        border-color 0.15s ease,
        color 0.15s ease;
    }
    nav a:hover {
      color: #b8441f;
      border-bottom-color: #e8b98a;
    }
    nav a.active {
      color: #e8622c;
      border-bottom-color: #e8622c;
    }
  }
</style>

<style is:global>
  * {
    font-family: "Nunito Sans", sans-serif;
    color: #3d2b1f;
  }
  body {
    background-color: #fffaf3;
  }

  .content {
    width: 100%;
    max-width: 1100px;
    margin: 60px auto;
    padding: 0 20px;
    box-sizing: border-box;

    h2 {
      font-family: "Fraunces", serif;
      font-weight: 700;
      font-size: 2em;
      color: #b8441f;
    }
    p {
      font-size: 1.15em;
      line-height: 1.6;
    }
  }

  .likes {
    border-top: 2px dashed #e8622c;
    background-color: #fff3e6;
    margin-top: 40px;
    border-radius: 8px;
    display: flex;
    padding: 16px;
    gap: 20px;
    align-items: center;

    button {
      background-color: #4a7c59;
      border: 0;
      color: #fff;
      padding: 8px 16px;
      font-size: 1em;
      font-weight: 600;
      border-radius: 6px;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }
    button:hover {
      background-color: #3a6347;
    }
  }
</style>
