---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Recipe Bites">
  <div class="content">
    <h2>Welcome to Recipe Bites</h2>

    <p>
      A little collection of recipes I've cooked, tweaked, and occasionally set off the smoke alarm making. Pull up a
      chair, grab a snack, and see what's cooking.
    </p>
    <a href="/recipes">Take a look at my recipes</a>
  </div>
</BaseLayout>

<style>
  .content {
    text-align: center;
  }
  a {
    display: inline-block;
    background-color: #e8622c;
    color: #fff;
    padding: 8px 16px;
    border-radius: 6px;
    text-decoration: none;
    margin-top: 20px;
    font-weight: 700;
  }
  a:hover {
    background-color: #c9501f;
  }
</style>
