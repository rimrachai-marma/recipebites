---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import RecipeCard from "../../../components/RecipeCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const recipes = await getCollection("recipes");
  return paginate(recipes, { pageSize: 4 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const pageNumbers: number[] = [];
for (let i = page.currentPage - 3; i <= page.currentPage + 3; i++) {
  if (i < 1) continue;
  if (i > page.lastPage) break;
  pageNumbers.push(i);
}
---

<BaseLayout title={`Recipes (Page ${page.currentPage}) | Recipe Bites`}>
  <div class="content">
    <h2>Recipes</h2>
    {page.data.map((recipe) => <RecipeCard recipe={recipe} />)}

    {!page.data.length && <p>No recipes to show.</p>}

    <!-- PAGINATION -->
    {
      page.lastPage > 1 && (
        <div class="pagination-wrap">
          <nav class="pagination">
            {page.url.prev ? <a href={page.url.prev}>← previous</a> : <span class="disabled">← previous</span>}

            {pageNumbers.map((n) =>
              n === page.currentPage ? (
                <span class="current" aria-current="page">
                  {n}
                </span>
              ) : (
                <a href={`/recipes/page/${n}`}>{n}</a>
              ),
            )}

            {page.url.next ? <a href={page.url.next}>next →</a> : <span class="disabled">next →</span>}
          </nav>

          <p class="page-count">
            Page {page.currentPage} of {page.lastPage}
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  h2 {
    padding-left: 12px;
    border-left: 8px solid #4a7c59;
    margin-bottom: 40px;
  }
  .pagination-wrap {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid #f0dcc4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
  }
  .pagination a,
  .pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    padding: 0 12px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
  }
  .pagination a {
    color: #6b4423;
    border: 1px solid #f0dcc4;
    background-color: #fff8f0;
  }
  .pagination a:hover {
    background-color: #fff3e6;
    border-color: #e8b98a;
  }
  .pagination .current {
    background-color: #e8622c;
    color: #fff;
    border: 1px solid #e8622c;
    cursor: default;
  }
  .pagination .disabled {
    color: #d8c8b4;
    background-color: #fff8f0;
    border: 1px solid #f0dcc4;
    cursor: not-allowed;
  }
  .page-count {
    color: #6b4423;
    font-size: 0.9em;
    margin: 0;
  }
</style>
