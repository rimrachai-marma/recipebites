---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  recipe: CollectionEntry<"recipes">;
}

const { recipe } = Astro.props;
---

<div class="recipe-card">
  <div class="recipe-image">
    {recipe.data.image && <Image src={recipe.data.image} alt={recipe.data.title} width={200} height={200} />}
    <span class="recipe-rating">{recipe.data.rating}/10</span>
  </div>
  <div class="recipe-body">
    <p class="recipe-title">{recipe.data.title}</p>
    <p class="recipe-chef">by {recipe.data.chef}</p>
    <p class="recipe-summary">{recipe.data.summary}</p>
    <a class="recipe-link" href={`/recipes/${recipe.id}`}>
      View Recipe <span class="recipe-arrow">→</span>
    </a>
  </div>
</div>

<style>
  .recipe-card {
    display: flex;
    gap: 20px;
    background-color: #fff8f0;
    border: 1px solid #f0dcc4;
    border-radius: 10px;
    padding: 16px;
    margin: 20px auto;
    box-shadow: 0 4px 0 #e8b98a;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .recipe-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 0 #e8b98a;
  }
  .recipe-image {
    position: relative;
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    border-radius: 8px;
    overflow: hidden;
    border: 2px solid #e8b98a;
  }
  .recipe-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .recipe-rating {
    position: absolute;
    bottom: 6px;
    right: 6px;
    background-color: #4a7c59;
    color: #fff;
    font-size: 0.75em;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 20px;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.15);
  }
  .recipe-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .recipe-title {
    font-family: "Fraunces", serif;
    font-size: 1.4em;
    font-weight: 700;
    color: #b8441f;
    margin: 0;
  }
  .recipe-chef {
    margin-top: 4px;
    font-style: italic;
    color: #6b4423;
  }
  .recipe-summary {
    font-size: 1em;
    margin-bottom: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .recipe-link {
    align-self: self-start;
    margin-top: auto;
    padding-top: 8px;
    color: #e8622c;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .recipe-link:hover {
    color: #b8441f;
  }
  .recipe-arrow {
    display: inline-block;
    transition: transform 0.15s ease;
  }
  .recipe-link:hover .recipe-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 480px) {
    .recipe-card {
      flex-direction: column;
    }
    .recipe-image {
      width: 100%;
      height: 160px;
    }
  }
</style>
